.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# wz
/wz

# 腳本
/scripts

# 規劃
/docs

# Claude Code：專案說明、本機設定、暫時 worktree 都只屬於這台機器
CLAUDE.md
CLAUDE.local.md
.claude/

# Build output. This also covers everything `Launcher.bat test` produces -
# build/test-classes, build/test-sources.txt, build/javac-test.log and any
# build/test-reports - so the test mode needs no ignore line of its own.
# JarLib/test/ is deliberately NOT ignored: the JUnit console-standalone jar is
# checked in, like every other jar in the tree.
/build
# The hand-compile recipe in CLAUDE.md writes its file list to the repo root.
/sources.txt

# CashShopDumper output (regenerated by `Launcher.bat cashshop`)
/cashshopItems
# MonsterDropCreator appends to this in the working directory.
/mobDrop.sql
# The in-game profiler command saves here unless given a file name.
/odinprofile.txt
# The WZ data as it is usually passed around, before it is extracted into /wz.
/wz.rar
/wz.zip
/wz.7z

# Local config - copy Settings.ini.example and fill in the DB credentials
/Settings.ini

# Runtime logs (the server creates Logs/ itself on startup).
# Logs/LogIPs.txt is the opt-in per-IP packet monitor list - create it by hand,
# one address per line, then run !reloadipmonitor.
/Logs
/PacketLog.txt

# Management panel frontend (panel/): dependencies and the Vite build output.
# Launcher.bat rebuilds panel/dist when panel/ changes and copies it into the jar.
/panel/node_modules
/panel/dist
/panel/tools/shots
/panel/tools/.chrome-profile
/panel/*.tsbuildinfo
npm-debug.log*

# JVM crash dumps (written to the working directory when the JVM dies).
hs_err_pid*.log
replay_pid*.log

# IDE / editor metadata. There is no IDE build here - Launcher.bat is the only
# entry point - so none of these belong in the repo.
.idea/
*.iml
.vscode/
nbproject/
.settings/
.project
.classpath
/out/
/bin/

# Backup and temp files. *.tmp also covers the panel script editor's
# Libs/scripts/<kind>/<name>.tmp, which only survives if a save is interrupted.
*.tmp
*.bak
*.orig
*.rej
*.swp
*~
